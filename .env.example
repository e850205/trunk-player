# Copy this file to .env and edit it, docker compose reads it automatically.

# REQUIRED - long random strings, e.g. from: openssl rand -base64 48
SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me

# Admin account created on first start (log in at /admin/)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# Token trunk-recorder scripts send to /api_v2/import_transmission/
# Leave empty to disable that API.
ADD_TRANS_AUTH_TOKEN=

SITE_TITLE=Trunk-Player
TZ=America/Los_Angeles

# Host folder with the audio + json files from trunk-recorder
AUDIO_DIR=./audio_files

# Ports on this machine
HTTP_PORT=80
HTTPS_PORT=8443

# Host names the site is reached by (space separated), * allows any
ALLOWED_HOSTS=*
# When using https set this to the site address, e.g. https://scanner.example.com
CSRF_TRUSTED_ORIGINS=

# Allow people to create their own accounts
OPEN_SITE=False
